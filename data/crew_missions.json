{
 "_meta": {
  "title": "Crew Dragon mission telemetry & reconstruction database",
  "built": "2026-08-26",
  "purpose": "Per-mission ascent facts for the DragonScreen autopilot. Only DM-1 has raw extracted time-series telemetry; every other mission is reconstructed from the DM-1 template keyed to that mission's published callout timeline + target orbit.",
  "confidence": {
   "P": "cited primary/authoritative",
   "E": "established",
   "D": "derived/reconstructed",
   "~": "approximate/verify"
  },
  "reconstruction_basis": "data/dm1_ascent_template.json (pitch + throttle/g) and data/dm1_ascent_full.json (539-sample full profile)",
  "met_units": "seconds relative to liftoff (negative = countdown)",
  "selection": "The autopilot picks a mission by matching the VAB craft name (vessel.vesselName) to a mission 'name' here. Build one vehicle per mission, named exactly as the mission. No match -> generic ISS-crew fallback + NO-GO note.",
  "vehicle_setup_fields": "Per mission, user-SETTABLE in the VAB (DB gives the real default): capsule, booster {tail, flights_flown} (feeds TestFlight wear/reliability), fuel_load (crew LEO = full; booster reserve is emergent from MECO energy), decals/livery (cosmetic, shown on screen). The guidance reads the RESULTING vehicle state from ground truth and flies physics; setup is data it measures, never a scripted branch."
 },
